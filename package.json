{
  "name": "skyatlas-mcp",
  "version": "0.1.0",
  "description": "Flutter-aware whole-repo structural intelligence for AI assistants, over MCP",
  "type": "module",
  "author": "ajay gujja <ajaygujja5@gmail.com>",
  "homepage": "https://github.com/ajaygujja/skyatlas_mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ajaygujja/skyatlas_mcp.git"
  },
  "bugs": {
    "url": "https://github.com/ajaygujja/skyatlas_mcp/issues"
  },
  "bin": {
    "skyatlas-mcp": "dist/server.js"
  },
  "files": [
    "dist",
    "vendor/tree-sitter-dart.wasm",
    "vendor/GRAMMAR_VERSION"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm run lint && pnpm run build && pnpm run test",
    "dev": "tsc -p tsconfig.build.json --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "dump-tree": "tsx scripts/dump-tree.ts",
    "doctor": "tsx scripts/doctor.ts",
    "benchmark": "tsx scripts/benchmark.ts",
    "lint": "eslint src scripts --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "flutter",
    "dart",
    "mcp",
    "tree-sitter",
    "code-intelligence"
  ],
  "license": "MIT",
  "packageManager": "pnpm@11.6.0",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "chokidar": "^5.0.0",
    "ignore": "^7.0.5",
    "web-tree-sitter": "0.26.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.3",
    "eslint": "^10.5.0",
    "prettier": "^3.8.4",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0",
    "vitest": "^4.1.8"
  }
}
