{
  "name": "flutter-intel-mcp",
  "version": "0.1.0",
  "description": "Flutter-aware whole-repo structural intelligence for AI assistants, over MCP",
  "type": "module",
  "bin": {
    "flutter-intel-mcp": "dist/server.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "dump-tree": "tsx scripts/dump-tree.ts",
    "benchmark": "tsx scripts/benchmark.ts",
    "lint": "eslint src scripts --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "flutter",
    "dart",
    "mcp",
    "tree-sitter",
    "code-intelligence"
  ],
  "license": "MIT",
  "packageManager": "pnpm@10.28.2",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "ignore": "^7.0.5",
    "web-tree-sitter": "0.26.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.3",
    "eslint": "^10.5.0",
    "prettier": "^3.8.4",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0",
    "vitest": "^4.1.8"
  }
}
